"""应用配置：全部环境变量在此收口。每项都有本地开发默认值 + 部署环境变量覆盖。"""
import os
import warnings

# 项目根目录（backend/）
BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# 上传文件存储目录（Docker 部署重定向到持久化卷 /data/uploads）
UPLOAD_DIR = os.environ.get("UPLOAD_DIR", os.path.join(BASE_DIR, "uploads"))
os.makedirs(UPLOAD_DIR, exist_ok=True)

# 前端静态资源目录（后端直接挂载，免独立前端服务）
ADMIN_DIR = os.path.join(BASE_DIR, "..", "frontend", "admin")
USER_DIR = os.path.join(BASE_DIR, "..", "frontend", "student")

# SQLite 数据库（Docker 部署重定向到 /data/app.db）
DB_PATH = os.environ.get("DB_PATH", os.path.join(BASE_DIR, "app.db"))
DATABASE_URL = f"sqlite:///{DB_PATH}"

# ===== 签名密钥三级策略：环境变量 > 落盘文件 > 首次生成落盘 =====
_SECRET_FILE = os.path.join(BASE_DIR, ".secret_key")
if os.environ.get("APP_SECRET"):
    _raw = os.environ["APP_SECRET"]
    # 安全检查：拒绝弱密钥（fail-fast，不打警告继续跑）
    _WEAK = {"changeme", "secret", "test", "fallback-secret"}
    if _raw.lower() in _WEAK or len(_raw) < 32:
        raise RuntimeError("SECURITY: APP_SECRET 强度不足！请用 openssl rand -hex 32 生成")
    if len(set(_raw)) < 8:
        raise RuntimeError("SECURITY: APP_SECRET 字符多样性不足（疑似弱随机）！")
    SECRET = _raw
elif os.path.exists(_SECRET_FILE):
    with open(_SECRET_FILE) as f:
        SECRET = f.read().strip()
else:
    import secrets
    SECRET = secrets.token_hex(32)
    try:
        with open(_SECRET_FILE, "w") as f:
            f.write(SECRET)  # 落盘复用，保证重启后 token 不失效
    except Exception:
        pass
    warnings.warn("未设置 APP_SECRET，已自动生成随机密钥并保存到 .secret_key", RuntimeWarning)

# CORS 白名单（生产必须设为实际来源，逗号分隔）
ALLOWED_ORIGINS = [
    o.strip() for o in os.environ.get(
        "ALLOWED_ORIGINS", "http://localhost:8000,http://127.0.0.1:8000"
    ).split(",") if o.strip()
]

# Token 有效期（天）
TOKEN_EXPIRE_DAYS = int(os.environ.get("TOKEN_EXPIRE_DAYS", "7"))

# 速率限制开关（测试可置 0）
RATE_LIMIT_ENABLED = os.environ.get("RATE_LIMIT_ENABLED", "1") == "1"

# 初始管理员密码（未设置则 seed 生成随机密码并打印一次）
ADMIN_INIT_PASSWORD = os.environ.get("ADMIN_INIT_PASSWORD", "")
