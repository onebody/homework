# ============================================================================
# 环境变量配置模板 —— 复制为 .env 后填入实际值（.env 已被 .gitignore 排除）
#   cp .env.example .env
# ============================================================================

# 签名密钥（必填，至少 32 字符的强随机串，生成命令：openssl rand -hex 32）
SUMMER_SECRET=<请填入-openssl-rand-hex-32-生成的密钥>

# CORS 允许的来源（生产环境设置为实际域名/地址，多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 速率限制（1=开启 0=关闭，生产环境务必开启）
RATE_LIMIT_ENABLED=1

# 初始管理员密码（选填；不设置则 seed 自动生成随机密码并在控制台输出）
ADMIN_INIT_PASSWORD=

# ---- 部署脚本 scripts/deploy.sh prod 所需（仅部署机需要）----
# DEPLOY_SSH_HOST=<生产服务器地址>
# DEPLOY_SSH_PASS=<SSH密码，建议改用密钥登录>
# DEPLOY_SSH_USER=root
# DEPLOY_SSH_PORT=22
# DEPLOY_APP_PORT=9000
# DEPLOY_ALLOWED_ORIGINS=<逗号分隔的CORS白名单>
