# ============================================================================
# 环境变量配置模板 —— 复制为 .env 后填入实际值（.env 已被 .gitignore 排除）
#   cp .env.example .env
# ============================================================================

# 签名密钥（必填，至少 32 字符的强随机串，生成命令：openssl rand -hex 32）
SUMMER_SECRET=<请填入-openssl-rand-hex-32-生成的密钥>

# CORS 允许的来源（生产环境设置为实际域名/地址，多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 速率限制（1=开启 0=关闭，生产环境务必开启）
RATE_LIMIT_ENABLED=1

# 初始管理员密码（推荐留空：留空则 seed 生成随机强密码并在启动日志中输出一次）
# 切勿填写 admin123 / 123456 类弱口令
ADMIN_INIT_PASSWORD=

# ---- 部署脚本 scripts/deploy.sh prod 所需（仅部署机需要）----
# DEPLOY_SSH_HOST=<生产服务器地址>
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519      # 推荐：密钥认证，与下方密码二选一
# DEPLOY_SSH_PASS=<SSH密码>            # 回退方案，经 SSHPASS 环境变量传递
# DEPLOY_SSH_STRICT=accept-new          # 主机密钥校验策略（默认值）
# DEPLOY_SSH_USER=root
# DEPLOY_SSH_PORT=22
# DEPLOY_APP_PORT=9000
# DEPLOY_BIND_ADDR=127.0.0.1            # 容器端口绑定地址（默认仅本机）
# DEPLOY_READONLY_FS=0                  # 1=容器根文件系统只读（需先验证）
# DEPLOY_ALLOWED_ORIGINS=<逗号分隔的CORS白名单>
